{
  "name": "@wifi-presence/gateway",
  "version": "0.1.0",
  "private": true,
  "description": "Gateway between the RuView WiFi sensing server and the mobile app.",
  "main": "dist/backend/src/index.js",
  "scripts": {
    "dev": "MOCK_RUVIEW=true ts-node -r tsconfig-paths/register src/index.ts",
    "start": "node dist/backend/src/index.js",
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "express": "^4.19.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.0",
    "@types/ws": "^8.5.10",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.4",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.9.5",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.5.4"
  }
}
